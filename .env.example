# Copy this template to .env once; put real keys only in the ignored .env file.
# Compose and Spring's local profile read .env from the project working directory.
# Use plain KEY=value lines, without quotes or export. Restart after editing.
# Use only for local development. Never commit real provider keys.
POSTGRES_DB=igilro
POSTGRES_USER=igilro
POSTGRES_PASSWORD=igilro_local
POSTGRES_PORT=5432

# Comma-separated immutable graph versions with independently verified flat-ground walking context.
# Keep empty until bridge/tunnel/indoor/terrain verification is recorded. Building data alone is insufficient.
SHADE_GROUND_VERIFIED_DATASETS=

# Building-source credentials used by the explicit Python collection commands.
VWORLD_API_KEY=
# URL/domain registered with the VWorld key, when required by the provider.
VWORLD_DOMAIN=
BUILDING_HUB_API_KEY=

# Kakao Developers -> app -> Kakao Map enabled -> REST API key. Server-only.
# Empty disables only place search (503 PLACE_SEARCH_NOT_CONFIGURED); routes still work.
KAKAO_REST_API_KEY=
PLACES_CONNECT_TIMEOUT=2s
PLACES_RESPONSE_TIMEOUT=3s
# Per server process, evenly spaced admission (default: one request per 250 ms).
# At most two upstream calls per admitted search (keyword, then address if empty).
PLACES_REQUESTS_PER_SECOND=4
