# Compose reads the DB settings after copying this file to .env.
# Spring bootRun does not load .env automatically; export it in your local shell.
# Use only for local development. Never commit real provider keys.
POSTGRES_DB=igilro
POSTGRES_USER=igilro
POSTGRES_PASSWORD=igilro_local
POSTGRES_PORT=5432

# Kakao Developers -> app -> Kakao Map enabled -> REST API key. Server-only.
# Empty disables only place search (503 PLACE_SEARCH_NOT_CONFIGURED); routes still work.
KAKAO_REST_API_KEY=
PLACES_CONNECT_TIMEOUT=2s
PLACES_RESPONSE_TIMEOUT=3s
# Per server process, evenly spaced admission (default: one request per 250 ms).
# At most two upstream calls per admitted search (keyword, then address if empty).
PLACES_REQUESTS_PER_SECOND=4
